# Copy to .env and adjust as needed. All values are optional.
SIA_ENDPOINT=https://irsa.ipac.caltech.edu/SIA
DEFAULT_COLLECTION=spherex_qr3
STORAGE_DIR=storage
LOG_LEVEL=INFO

# HTTP
CONNECT_TIMEOUT=10
REQUEST_TIMEOUT=120
DOWNLOAD_RETRIES=3
MAX_DOWNLOAD_BYTES=268435456

# Limits (degrees)
MAX_SEARCH_RADIUS_DEG=1.0
MAX_CUTOUT_SIZE_DEG=1.0

# Spectral extraction (Phase 4, SPHEREx DR1 all-sky cube)
SPECTRAL_COLLECTION=spherex_dr1_cube
SPECTRAL_MAX_DOWNLOAD_BYTES=419430400
SPECTRAL_SPATIAL_METHOD=bilinear
MAX_CONCURRENT_SPECTRAL=2
# Bits 1 (OVERFLOW) and 19 (outlier) invalidate a cube channel; bit 21 (SOURCE) is informational.
# SPECTRAL_INVALID_FLAG_BITS=[1,19]

# Caching
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=512

# Comma-separated in .env is not supported for tuples; use JSON syntax:
# TRUSTED_HOSTS=["irsa.ipac.caltech.edu"]
# Browser origins allowed to call the API. List explicit origins only:
# the "*" wildcard is rejected at startup (unrestricted CORS is not allowed).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
